MANIFEST

# Virtual environments
venv/
env/
ENV/

# Node.js
# 说明：.dockerignore 的模式锚定在上下文根目录，所以需要 **/ 才能覆盖 frontend/ 下的内容。
node_modules/
**/node_modules/
frontend/dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Data
data/
uploads/
temp/
output/

# Docker
Dockerfile*
docker-compose*
.dockerignore

# Documentation
docs/
*.md
!README.md

# Scripts
*.sh
# Container entrypoints are COPY'd by Dockerfile / Dockerfile.dev; excluding
# them makes `docker build` fail with "/docker-entrypoint.sh: not found".
!docker-entrypoint.sh
!docker-dev-entrypoint.sh
# Railway 镜像 COPY 的子目录入口脚本（上一行的 *.sh 只匹配根目录文件，这里显式放行更稳妥）。
!deploy/railway/*.sh

# Environment
.env
.env.local
.env.development
.env.test
.env.production
.env.*
# Never copy updater signing keys into a Docker build context.
.updater-private-key*

# Backup
cleanup_backup/
*.backup

# Test files
test_*.py
*_test.py
tests/

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Celery
celerybeat-schedule
celerybeat.pid

# Redis
dump.rdb

# PID files
*.pid
*.pid.json
*.pid.tmp
